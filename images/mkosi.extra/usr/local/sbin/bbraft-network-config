#!/bin/sh
# bbraft-network-config: turn the kernel ip= parameter into the static
# systemd-networkd unit a TAP-mode guest uses.
#
# QEMU user-mode networking (the explicit dev/test fallback) passes no ip=;
# this script then does nothing and the image's DHCP unit (20-bbraft.network)
# applies unchanged. TAP mode passes exactly this form, produced by
# internal/node/qemu:
#
#   ip=<guest>::<gateway>:<netmask>:::<autoconf off>[:<dns0>[:<dns1>]]
#
# which becomes /run/systemd/network/10-bbraft-static.network, ordered before
# 20-bbraft.network so networkd configures the same address, gateway and DNS
# the kernel did and keeps them instead of running a DHCP client for a server
# the node never chose.
#
# The parser is strict and shell-only: kernel data is never evaluated, never
# passed through sh -c and never globbed, and malformed input fails closed by
# configuring no address, DHCP or RA at all rather than guessing a network.
#
# Test-only overrides (never set in production): BBRAFT_CMDLINE_FILE,
# BBRAFT_NETWORK_DIR.
set -eu
umask 022

cmdline_file=${BBRAFT_CMDLINE_FILE:-/proc/cmdline}
network_dir=${BBRAFT_NETWORK_DIR:-/run/systemd/network}
unit_name=10-bbraft-static.network

# The unit directory must exist before any fail-closed write; a failure here is
# a real error (the guest would get no configuration at all).
mkdir -p "$network_dir"

# emit_no_network writes a matching unit that leaves the NIC unconfigured.
# Used for malformed input: no DHCP or RA fallback, because a fallback could
# lease an address from a server the node did not configure.
emit_no_network() {
	tmp=$network_dir/.$unit_name.tmp.$$
	if ! cat >"$tmp" <<'EOF'
# Generated by bbraft-network-config after a malformed kernel ip= parameter.
# Do not edit: this file lives in /run and is regenerated on every boot.
# No address, route, DHCP or RA is configured on purpose: an invalid
# configuration must not fall back to a server the node did not choose.
[Match]
Name=en* eth*
Type=ether

[Network]
DHCP=no
IPv6AcceptRA=no
LinkLocalAddressing=no
EOF
	then
		rm -f "$tmp"
		return 1
	fi
	# -T makes the destination a normal file: if it is a directory, the move
	# must fail instead of silently placing the unit inside it, which would
	# leave networkd with no static unit at the expected path.
	mv -Tf "$tmp" "$network_dir/$unit_name" || {
		rm -f "$tmp"
		return 1
	}
}

# fail_closed reports a rejected parameter and leaves the guest with no
# network configuration. It is not an error exit: the boot must finish so the
# node can observe the guest and its operator can read the journal. A failure
# to install the fail-closed unit is a real error, though: the caller must exit
# non-zero so networkd is gated rather than falling back to DHCP.
fail_closed() {
	printf 'bbraft-network-config: %s; refusing DHCP/RA fallback\n' "$*" >&2
	emit_no_network || exit 1
	exit 0
}

# is_ipv4 accepts four decimal octets, 0..255, without leading zeros. The
# substring is split on dots inside a subshell: it can only contain digits and
# dots, globbing is disabled, and nothing is evaluated.
is_ipv4() (
	set -f
	case $1 in
	'' | *[!0-9.]* | .* | *. | *..*) exit 1 ;;
	esac
	IFS=.
	# shellcheck disable=SC2086 # intentional dot splitting of a digits-only value
	set -- $1
	[ $# -eq 4 ] || exit 1
	for octet do
		case $octet in
		'' | *[!0-9]*) exit 1 ;;
		0?*) exit 1 ;;
		esac
		[ ${#octet} -le 3 ] || exit 1
		[ "$octet" -le 255 ] || exit 1
	done
	exit 0
)

# mask_prefix returns the prefix length of a contiguous dotted-quad netmask and
# fails for anything else (for example 255.0.255.0 or /31).
mask_prefix() (
	is_ipv4 "$1" || exit 1
	IFS=.
	# shellcheck disable=SC2086 # intentional dot splitting of a validated mask
	set -- $1
	bits=0
	seen_short=0
	for octet do
		case $octet in
		255) n=8 ;;
		254) n=7 ;;
		252) n=6 ;;
		248) n=5 ;;
		240) n=4 ;;
		224) n=3 ;;
		192) n=2 ;;
		128) n=1 ;;
		0) n=0 ;;
		*) exit 1 ;;
		esac
		if [ "$seen_short" -eq 1 ] && [ "$n" -ne 0 ]; then
			exit 1
		fi
		if [ "$n" -ne 8 ]; then
			seen_short=1
		fi
		bits=$((bits + n))
	done
	[ "$bits" -ge 8 ] && [ "$bits" -le 30 ] || exit 1
	printf '%s\n' "$bits"
)

# in_subnet succeeds when client and gateway are both usable host addresses in
# the mask's subnet. Network and broadcast addresses are rejected for both.
in_subnet() (
	client=$1 gateway=$2 mask=$3
	IFS=.
	# shellcheck disable=SC2086 # all three values are validated IPv4 strings
	set -- $client
	c1=$1 c2=$2 c3=$3 c4=$4
	# shellcheck disable=SC2086
	set -- $mask
	m1=$1 m2=$2 m3=$3 m4=$4
	# shellcheck disable=SC2086
	set -- $gateway
	g1=$1 g2=$2 g3=$3 g4=$4
	host1=$((255 - m1))
	host2=$((255 - m2))
	host3=$((255 - m3))
	host4=$((255 - m4))
	hosts=$((host1 + host2 + host3 + host4))
	[ $((c1 & m1)) -eq $((g1 & m1)) ] || exit 1
	[ $((c2 & m2)) -eq $((g2 & m2)) ] || exit 1
	[ $((c3 & m3)) -eq $((g3 & m3)) ] || exit 1
	[ $((c4 & m4)) -eq $((g4 & m4)) ] || exit 1
	client_host=$(((c1 & host1) + (c2 & host2) + (c3 & host3) + (c4 & host4)))
	gateway_host=$(((g1 & host1) + (g2 & host2) + (g3 & host3) + (g4 & host4)))
	[ "$client_host" -gt 0 ] && [ "$client_host" -ne "$hosts" ] || exit 1
	[ "$gateway_host" -gt 0 ] && [ "$gateway_host" -ne "$hosts" ] || exit 1
	exit 0
)

# valid_unicast rejects every address class that cannot name a guest, gateway
# or resolver: 0/8 (unspecified/this-network), loopback, multicast and the
# reserved/lower broadcast space. Broadcast and network addresses inside the
# guest subnet are rejected separately by in_subnet.
valid_unicast() (
	is_ipv4 "$1" || exit 1
	IFS=.
	# shellcheck disable=SC2086 # the value is a validated IPv4 string
	set -- $1
	first=$1
	[ "$first" -ge 1 ] || exit 1
	[ "$first" -ne 127 ] || exit 1
	[ "$first" -le 223 ] || exit 1
	exit 0
)

# valid_resolver accepts a unicast IPv4 resolver that is not inside the
# guest's own subnet.
valid_resolver() (
	dns=$1 gateway=$2 mask=$3
	valid_unicast "$dns" || exit 1
	if in_subnet "$dns" "$gateway" "$mask"; then
		exit 1
	fi
	exit 0
)

[ -r "$cmdline_file" ] || {
	printf 'bbraft-network-config: cannot read %s\n' "$cmdline_file" >&2
	exit 1
}
cmdline=$(cat "$cmdline_file")

# Collect the single ip= parameter. Globbing is disabled; the loop only
# splits kernel words, it never evaluates them.
set -f
ip_count=0
ip_value=
for word in $cmdline; do
	case $word in
	ip=*)
		ip_count=$((ip_count + 1))
		ip_value=${word#ip=}
		;;
	esac
done
set +f

[ "$ip_count" -le 1 ] || fail_closed "multiple ip= parameters"
# No ip= at all is the user-mode fallback: DHCP stays exactly as shipped.
[ "$ip_count" -eq 1 ] || exit 0
case $ip_value in
dhcp | link-local) exit 0 ;;
esac
[ -n "$ip_value" ] || fail_closed "empty ip= parameter"
case $ip_value in
*:) fail_closed "ip= has a trailing empty field" ;;
esac

old_ifs=$IFS
IFS=:
set -f
# shellcheck disable=SC2086 # intentional colon splitting of the ip= value
set -- $ip_value
IFS=$old_ifs
set +f
[ $# -ge 7 ] && [ $# -le 9 ] || fail_closed "ip= must have 7 to 9 fields"
client=$1
server=$2
gateway=$3
mask=$4
hostname=$5
device=$6
autoconf=$7
dns0=
dns1=
[ $# -ge 8 ] && dns0=$8
[ $# -ge 9 ] && dns1=$9

[ -z "$server" ] || fail_closed "server field must be empty"
[ -z "$hostname" ] || fail_closed "hostname field must be empty"
[ -z "$device" ] || fail_closed "device field must be empty; the image has one NIC"
[ "$autoconf" = off ] || fail_closed "autoconf must be off"
valid_unicast "$client" || fail_closed "client address is not a unicast IPv4 address"
valid_unicast "$gateway" || fail_closed "gateway is not a unicast IPv4 address"
[ "$client" != "$gateway" ] || fail_closed "client and gateway are the same address"
prefix=$(mask_prefix "$mask") || fail_closed "netmask is not a contiguous /8../30"
in_subnet "$client" "$gateway" "$mask" ||
	fail_closed "client and gateway are not usable host addresses in one subnet"
for dns in "$dns0" "$dns1"; do
	[ -n "$dns" ] || continue
	valid_resolver "$dns" "$gateway" "$mask" ||
		fail_closed "resolver $dns is not a usable IPv4 resolver outside the guest subnet"
done

mkdir -p "$network_dir"
tmp=$network_dir/.$unit_name.tmp.$$
if ! cat >"$tmp" <<EOF
# Generated by bbraft-network-config from the kernel ip= parameter at boot.
# Do not edit: this file lives in /run and is regenerated on every boot.
[Match]
Name=en* eth*
Type=ether

[Network]
DHCP=no
IPv6AcceptRA=no
LinkLocalAddressing=no
Address=$client/$prefix
Gateway=$gateway
EOF
then
	rm -f "$tmp"
	exit 1
fi
for dns in "$dns0" "$dns1"; do
	[ -n "$dns" ] || continue
	printf 'DNS=%s\n' "$dns" >>"$tmp" || {
		rm -f "$tmp"
		exit 1
	}
done
# -T makes the destination a normal file: a directory at the unit path must
# fail the unit (and therefore gate networkd) instead of accepting a move of
# the unit inside the directory.
mv -Tf "$tmp" "$network_dir/$unit_name" || {
	rm -f "$tmp"
	exit 1
}
