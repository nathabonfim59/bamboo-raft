# Extra arguments for bbraft-guest. The A1.1 checkpoint fixed these flags
# (defaults shown): -guest.vsock-port 10789, -guest.vsock-cid any,
# -guest.uid 1000, -guest.gid 1000, -guest.home /home/user, -guest.tmp /tmp,
# -guest.freeze-lease 2m; all have BBRAFT_GUEST_* environment fallbacks.
# Only the port is spelled out so an omitted flag keeps its default.
# No platform credentials belong in this file or anywhere in the image.
BBRAFT_GUEST_ARGS="-guest.vsock-port 10789"
