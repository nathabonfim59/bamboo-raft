#!/usr/sbin/nft -f
# Managed by bamboo-raft infra/ansible (role hardening).
#
# Inbound: only the tailnet, loopback, replies to our own traffic, the
# Tailscale WireGuard port, DHCP and the ICMP that IPv4/IPv6 need. Nothing
# else reaches the host from its public interface.
#
# No `flush ruleset`: tailscaled keeps its own tables, and reloading this file
# replaces only the bbraft_filter table.

table inet bbraft_filter
delete table inet bbraft_filter

table inet bbraft_filter {
	chain input {
		type filter hook input priority filter; policy drop;

		ct state established,related accept
		ct state invalid drop
		iif lo accept
{% for iface in hardening_trusted_interfaces %}
		iifname "{{ iface }}" accept
{% endfor %}
{% if hardening_open_udp_ports | length > 0 %}
		udp dport { {{ hardening_open_udp_ports | join(', ') }} } accept
{% endif %}

		# DHCPv4 and DHCPv6 client replies.
		udp sport 67 udp dport 68 accept
		udp sport 547 udp dport 546 accept

		# ICMP: errors (path MTU) are covered by ct related; allow limited echo
		# and the neighbour discovery IPv6 cannot work without.
		ip protocol icmp icmp type echo-request limit rate 5/second accept
		ip6 nexthdr icmpv6 icmpv6 type { nd-neighbor-solicit, nd-neighbor-advert, nd-router-advert, nd-redirect, mld-listener-query } accept
		ip6 nexthdr icmpv6 icmpv6 type echo-request limit rate 5/second accept
	}

	chain forward {
		# Forward only through explicitly configured VM bridges. The node's
		# own nftables tables enforce VM isolation and allowed ingress/egress.
		# An empty list preserves a host that routes nothing.
		type filter hook forward priority filter; policy drop;
{% for iface in hardening_vm_bridge_interfaces %}
		meta nfproto ipv4 iifname "{{ iface }}" accept
		meta nfproto ipv4 oifname "{{ iface }}" accept
{% endfor %}
	}
}
